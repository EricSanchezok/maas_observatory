{
  "$defs": {
    "SnapshotStatus": {
      "enum": [
        "candidate",
        "released"
      ],
      "title": "SnapshotStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "archive_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Archive Sha256",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "notes": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "release_url": {
      "anyOf": [
        {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Release Url"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "$ref": "#/$defs/SnapshotStatus"
    },
    "title": {
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "title",
    "status",
    "archive_sha256",
    "created_at"
  ],
  "title": "PublicSnapshotMetadata",
  "type": "object"
}
