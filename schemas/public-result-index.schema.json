{
  "$defs": {
    "PublicSnapshotReference": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
          "title": "Path",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/SnapshotStatus"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "path",
        "title",
        "status"
      ],
      "title": "PublicSnapshotReference",
      "type": "object"
    },
    "SnapshotStatus": {
      "enum": [
        "candidate",
        "released"
      ],
      "title": "SnapshotStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "latest_run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latest Run Id"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "snapshots": {
      "items": {
        "$ref": "#/$defs/PublicSnapshotReference"
      },
      "title": "Snapshots",
      "type": "array"
    }
  },
  "title": "PublicResultIndex",
  "type": "object"
}
